# ==============================================================================
# STAYLIQUID BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Project URL and publishable key MUST be the same project the frontend uses,
# otherwise the backend cannot validate frontend-issued JWTs.
SUPABASE_URL=https://<your-project-id>.supabase.co

# Publishable (anon) key, safe to expose. Used for SSR auth and the browser client.
SUPABASE_ANON_KEY=sb_publishable_...

# Secret key with administrative privileges. Server-only. Never expose.
SUPABASE_SECRET_KEY=sb_secret_...

# ------------------------------------------------------------------------------
# REDIS CONFIGURATION (STANDARD TCP REDIS / IOREDIS)
# ------------------------------------------------------------------------------
# Hot-path idempotency and rate limiting. Supports standard TCP Redis:
# - Local: redis://localhost:6379
# - Self-hosted / Coolify / Docker: redis://:your_password@redis_host:6379
# - Cloud / Managed (TLS): rediss://default:your_token@your-host:6379
# If left empty, the backend falls back to an in-memory client in development.
REDIS_URL=redis://127.0.0.1:6379

# Optional TTL tuning (seconds)
IDEMPOTENCY_PROCESSING_TTL_SECONDS=900
IDEMPOTENCY_COMPLETED_TTL_SECONDS=86400

# Optional wallet-event SSE tuning (milliseconds)
WALLET_EVENTS_POLL_MS=4000
WALLET_EVENTS_HEARTBEAT_MS=15000

# ------------------------------------------------------------------------------
# SOLANA / BASE RPC CONFIGURATION
# ------------------------------------------------------------------------------
# Optional. Falls back to the public Solana mainnet RPC if unset.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Falls back to https://mainnet.base.org if unset.
BASE_RPC_URL=https://mainnet.base.org

# Solana USDC/USDT mint overrides (defaults are mainnet)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ------------------------------------------------------------------------------
# COINBASE CDP SDK CONFIGURATION
# ------------------------------------------------------------------------------
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET="your_cdp_api_key_secret"
CDP_WALLET_SECRET="your_cdp_wallet_secret"

# ------------------------------------------------------------------------------
# TREASURY / PLATFORM FEE WALLETS
# ------------------------------------------------------------------------------
# Platform fee treasury wallets per chain (receives the 5% platform fee on
# scheduled payouts and plan early-break actions).
# Note: Users pay their own network gas fees directly in native SOL or ETH.
SOLANA_PLATFORM_FEES_WALLET=your_solana_fee_treasury_address
BASE_PLATFORM_FEES_WALLET=your_base_fee_treasury_address

# ------------------------------------------------------------------------------
# SERVICE AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# One credential accepted by all internal service routes (payout, target payout,
# fiat webhook, recovery worker, wallet list, webhook admin, deep health, and
# CDP deposit webhook Custom Headers).
SERVICE_AUTH_TOKEN=your_service_token

# ------------------------------------------------------------------------------
# TELEGRAM BOT (fiat payout alerts & vendor bot)
# ------------------------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_ACCESS_TOKEN=your_telegram_bot_token

# Public base URL of this backend. POST /api/telegram/setup registers
# {TELEGRAM_WEBHOOK_URL}/api/telegram/webhook with Telegram.
TELEGRAM_WEBHOOK_URL=https://api.your-domain.example

# Secret token Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Password required by vendors to authenticate with the bot via /subscribe <code>.
# Alerts are delivered exclusively to authenticated vendors in public.vendors.
VENDOR_SUBSCRIPTION_CODE=your_subscription_code

# ------------------------------------------------------------------------------
# DEPOSIT WEBHOOK (COINBASE CDP)
# ------------------------------------------------------------------------------
# Deposit webhook authentication supports:
# 1) Custom Header: `Authorization: Bearer <SERVICE_AUTH_TOKEN>` (configured in CDP Portal)
# 2) Optional HMAC signing secret: if CDP provides an HMAC secret, set it here.
CDP_WEBHOOK_SECRET=your_cdp_webhook_signing_secret

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins for browser web apps
CORS_ALLOWED_ORIGINS=https://savewithliquid.xyz,https://savewithliquid.com,https://liquid-frontend-gray.vercel.app,http://localhost:3000
